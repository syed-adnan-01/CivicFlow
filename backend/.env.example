# Application Environment (development, test, production)
APP_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata

# Database (PostgreSQL with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://queueless:queueless_secret@localhost:5432/queueless_db

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=queueless-dev
# Path to service account json or left unset if using Google Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=
# Check token revocation on sensitive calls (or false for performance in dev)
FIREBASE_CHECK_REVOKED=false

# QR Reference Policy
QR_ROTATION_LIMIT=3
QR_ROTATION_WINDOW_SECONDS=600

# Idempotency Key Retention
IDEMPOTENCY_RETENTION_HOURS=24

# ----------------------------------------------------------------------------
# Member 4 — Groq (PRIMARY LLM) & Gemini (FALLBACK LLM + Embeddings)
# ----------------------------------------------------------------------------
# Groq API key — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Gemini API key — https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_PROVIDER=gemini

# ChromaDB Vector Store (RAG)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=queueless_verified_sources_v1

# RAG retrieval parameters
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=12000

# OCR Configuration
OCR_ENGINE=tesseract
OCR_LANGUAGE_PACKS=eng
OCR_MAX_FILE_MB=10
OCR_MAX_PAGES=10

# Document Storage (local dev path or GCS bucket name in production)
DOCUMENT_STORAGE_BUCKET=./data/storage
DOCUMENT_RETENTION_DAYS=90
