# =============================================================================
# QueueLess 2.3 — Backend Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to Git.
# =============================================================================

# --- App ---
APP_ENV=development                   # development | test | production
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database (Member 1) ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/queueless

# --- Firebase (Member 1) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=      # path to service-account JSON (dev only)
FIREBASE_CHECK_REVOKED=false

# --- QR / Idempotency (Member 1) ---
QR_ROTATION_LIMIT=3
QR_ROTATION_WINDOW_SECONDS=600
IDEMPOTENCY_RETENTION_HOURS=24

# =============================================================================
# Member 4 — LLM Providers (Groq primary → Gemini fallback)
# =============================================================================

# --- Groq (PRIMARY LLM) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=                         # KEEP SECRET — never commit
GROQ_MODEL=llama-3.1-70b-versatile    # or: llama-3.1-8b-instant, mixtral-8x7b-32768

# --- Gemini (FALLBACK LLM + Embeddings) ---
# Groq has no embeddings API — Gemini is always used for embeddings.
# Gemini also activates automatically when Groq hits its rate limit (HTTP 429).
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                       # KEEP SECRET — never commit
GEMINI_MODEL=gemini-1.5-flash         # or: gemini-1.5-pro

# --- Embedding Provider ---
# Groq does not provide embeddings. Gemini is always used.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=queueless_verified_sources_v1

# --- RAG Retrieval ---
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.70
RAG_MAX_CONTEXT_CHARS=12000

# --- OCR Engine ---
OCR_ENGINE=                           # paddle | tesseract (set after test gate)
OCR_LANGUAGE_PACKS=eng
OCR_MAX_FILE_MB=10
OCR_MAX_PAGES=10

# --- Document Storage ---
DOCUMENT_STORAGE_BUCKET=             # local path or cloud bucket name
DOCUMENT_RETENTION_DAYS=30
