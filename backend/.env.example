# Application Environment (development, test, production)
APP_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata

# Database (PostgreSQL with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://queueless:queueless_secret@localhost:5432/queueless_db

# Firebase Configuration
FIREBASE_PROJECT_ID=civicflow-18c55
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=civicflow-18c55.firebaseapp.com
FIREBASE_STORAGE_BUCKET=civicflow-18c55.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Frontend / Vite Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=civicflow-18c55.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civicflow-18c55
VITE_FIREBASE_STORAGE_BUCKET=civicflow-18c55.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Path to service account json or left unset if using Google Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=
# Check token revocation on sensitive calls (or false for performance in dev)
FIREBASE_CHECK_REVOKED=false

# QR Rotation Policy
QR_ROTATION_LIMIT=3
QR_ROTATION_WINDOW_SECONDS=600

# Idempotency Key Retention
IDEMPOTENCY_RETENTION_HOURS=24
