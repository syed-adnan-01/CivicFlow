# QueueLess Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/realtime/ws

# Firebase Web Client Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=mock-api-key-for-dev
VITE_FIREBASE_AUTH_DOMAIN=queueless-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=queueless-demo
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

